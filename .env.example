# Shopify app API key (Client ID) from the Partner Dashboard. Public.
SHOPIFY_API_KEY=00000000000000000000000000000000

# Shopify app API secret (Client Secret) from the Partner Dashboard. Keep private.
SHOPIFY_API_SECRET=replace-with-your-shopify-api-secret

# Comma-separated access scopes the app requests during OAuth. Read-only.
SCOPES=read_orders,read_shopify_payments_payouts

# Public HTTPS URL where the app is reachable (tunnel URL in dev, real domain in prod).
SHOPIFY_APP_URL=https://example-tunnel.trycloudflare.com

# Prisma database connection string. SQLite file in dev; PostgreSQL URL in prod.
DATABASE_URL=file:./dev.sqlite

# Minutes between automatic sync runs per shop. Default 360 (six hours).
RECON_POLL_MINUTES=360
